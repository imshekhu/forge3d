# Canonical production URL, with no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.ca

# Quote delivery through https://resend.com
RESEND_API_KEY=re_your_api_key
QUOTE_TO_EMAIL=your-inbox@example.com

# Use Resend's test sender during setup. Replace with a verified-domain sender
# before launch, for example: Forge3D Quotes <quotes@your-domain.ca>
QUOTE_FROM_EMAIL=Forge3D Quotes <onboarding@resend.dev>
